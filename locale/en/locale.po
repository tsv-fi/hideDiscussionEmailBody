msgid "plugins.generic.hideDiscussionEmailBody.displayName"
msgstr "Hide discussion messages from emails"

msgid "plugins.generic.hideDiscussionEmailBody.description"
msgstr "Hides the discussion message from the email notification send to users and forces the user to login and answer to the discussion message using the discussion tool."

msgid "plugins.generic.hideDiscussionEmailBody.discussion.updated"
msgstr ""
"<p>Dear {$recipientName},</p>\n"
"<p>{$senderName} sent a new message in {$journalName}.<br />\n"
"Please log in using the link below to view the discussion.</p>\n"
"<p>Kind regards,</p>\n"
"{$signature}"
